# ──────────────────────────────────────────────
#  Vikalp — .gitignore
# ──────────────────────────────────────────────

# Environment variables — NEVER commit these!
.env
.env.local
.env.*.local
backend/.env

# Dependencies
node_modules/
backend/node_modules/

# Build output
dist/
build/

# Uploads (user-submitted files — never commit)
uploads/
uploads/*.json

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Firebase service account key (if ever placed as a file)
serviceAccountKey.json
*serviceAccount*.json
