# ============================================================
#  VIKALP — Backend Environment Variables (.env)
#  Copy this file to .env inside the /backend folder and fill values.
#  NEVER commit your real .env to version control!
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Admin password for clearing all reports (change this!)
ADMIN_PASSWORD=change_this_secure_password

# ── MongoDB ──────────────────────────────────────────────────
# Local:       mongodb://localhost:27017/vikalp
# Atlas:       mongodb+srv://<user>:<pass>@cluster.mongodb.net/vikalp
MONGO_URI=mongodb://localhost:27017/vikalp

# ── CORS ─────────────────────────────────────────────────────
# In production set to your frontend URL, e.g. https://vikalp.vercel.app
CORS_ORIGIN=http://localhost:3000

# ── Firebase Admin SDK ───────────────────────────────────────
# Option A: Paste the full JSON as a single-line string (preferred for Render/Railway)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}

# Option B: Individual Firebase Admin SDK keys (used by serviceAccountKey.js)
# You only need ONE option — comment out the other.
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
# Keep the \n literal — the code replaces them with real newlines at runtime
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your_project_id.iam.gserviceaccount.com
FIREBASE_UNIVERSE_DOMAIN=googleapis.com
